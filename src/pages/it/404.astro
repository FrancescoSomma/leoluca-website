---
import Base from '../../layouts/Base.astro';
import { pathFor } from '../../i18n/routes';

const locale = 'it' as const;
---

{
  /*
    Nessun URL proprio: solo da quando netlify.toml avrà le regole del
    Task 10, Netlify servirà questa pagina con stato 404 su ogni percorso
    sconosciuto, dove canonical e hreflang non contano. L'unico indirizzo
    dove risponde 200 è /it/404/, e lì canonical e hreflang verso la home
    la tengono fuori dall'indice invece di dichiararla come pagina.
  */
}
<Base
  locale={locale}
  pageKey="home"
  title="Pagina non trovata — Leo Luca Iacoviello"
  description="La pagina che cerchi non esiste."
>
  <h1>Pagina non trovata</h1>
  <a href={pathFor('portfolio', locale)}>Vai al portfolio</a>
</Base>
