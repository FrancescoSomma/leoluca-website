---
import Base from '../../layouts/Base.astro';
import { pathFor } from '../../i18n/routes';
import { seoPer, corpoPer } from '../../content/load';
import { t } from '../../i18n/ui';

const locale = 'it' as const;
const { title, description } = seoPer('thanks', locale);
const corpo = corpoPer('thanks', locale);
---

<Base locale={locale} pageKey="thanks" title={title} description={description}>
  <h1>{t(locale, 'thanks.title')}</h1>
  {corpo && <p>{corpo}</p>}
  <p><a href={pathFor('portfolio', locale)}>{t(locale, 'thanks.backToPortfolio')}</a></p>
</Base>
