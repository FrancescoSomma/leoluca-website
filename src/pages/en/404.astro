---
import Base from '../../layouts/Base.astro';
import { pathFor } from '../../i18n/routes';

const locale = 'en' as const;
---

{
  /*
    Nessun URL proprio: solo da quando netlify.toml avrà le regole del
    Task 10, Netlify servirà questa pagina con stato 404 su ogni percorso
    sconosciuto, dove canonical e hreflang non contano. L'unico indirizzo
    dove risponde 200 è /en/404/, e lì canonical e hreflang verso la home
    la tengono fuori dall'indice invece di dichiararla come pagina.
  */
}
<Base
  locale={locale}
  pageKey="home"
  title="Page Not Found — Leo Luca Iacoviello"
  description="The page you are looking for does not exist."
>
  <h1>Page Not Found</h1>
  <a href={pathFor('portfolio', locale)}>Go to the portfolio</a>
</Base>
