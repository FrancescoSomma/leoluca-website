---
import Base from '../../layouts/Base.astro';
import FormContatto from '../../components/FormContatto.astro';
import { seoPer, corpoPer } from '../../content/load';
import { t } from '../../i18n/ui';

const locale = 'en' as const;
const { title, description } = seoPer('contact', locale);
const corpo = corpoPer('contact', locale);
---

<Base locale={locale} pageKey="contact" title={title} description={description}>
  <h1>{t(locale, 'contact.title')}</h1>
  {corpo && <p>{corpo}</p>}
  <FormContatto locale={locale} />
</Base>
